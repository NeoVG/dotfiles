# after sudo
complete -cf sudo

# git
source ${DIR}/helper/git-completion.sh
# Apply git aliases only in interactive shells to avoid .gitconfig.lock
# contention when many non-interactive children start in parallel.
if [[ $- == *i* ]]; then
	git config --global alias.co checkout
	git config --global alias.br branch
	git config --global alias.ci commit
	git config --global alias.st status
fi

# homebrew
if [ -f /usr/local/etc/bash_completion.d/brew ]; then
	source /usr/local/etc/bash_completion.d/brew
fi

