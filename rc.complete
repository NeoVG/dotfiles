# after sudo
complete -cf sudo

# System/Homebrew bash-completion
# Supports macOS Homebrew (Intel + Apple Silicon) and Linux (Ubuntu/Debian)
if [ -z "${BASH_COMPLETION_VERSINFO+x}" ]; then
	for _bc_path in /opt/homebrew/etc/profile.d/bash_completion.sh \
	                /usr/local/etc/profile.d/bash_completion.sh \
	                /usr/share/bash-completion/bash_completion \
	                /etc/bash_completion; do
		if [ -f "${_bc_path}" ]; then
			source "${_bc_path}"
			break
		fi
	done
	unset _bc_path
fi

# Fallback: bundled git completion for hosts without a system one
if ! type __git_complete &>/dev/null; then
	source ${DIR}/helper/git-completion.sh
fi
